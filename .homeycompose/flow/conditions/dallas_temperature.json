{
  "id": "dallas_temperature",
  "title": {
    "en": "Dallas temperature !{{is|is not}} above ...",
    "nl": "Dallas temperatuur !{{is|is niet}} hoger dan ..."
  },
  "titleFormatted": {
    "en": "[[sensor]] temperature !{{is|is not}} above [[temperature]] °C",
    "nl": "[[sensor]] temperatuur !{{is|is niet}} hoger dan [[temperature]] °C"
  },
  "hint": {
    "en": "Check if a Dallas temperature sensor is above a specific value.",
    "nl": "Controleer of een Dallas temperatuursensor hoger is dan een specifieke waarde."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=heatpump"
