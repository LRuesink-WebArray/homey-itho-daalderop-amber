      "title": {
        "en": "Sensor",
        "nl": "Sensor"
      },
      "values": [
        { "id": "dallas_1", "label": { "en": "Dallas 1", "nl": "Dallas 1" } },
        { "id": "dallas_2", "label": { "en": "Dallas 2", "nl": "Dallas 2" } },
        { "id": "dallas_3", "label": { "en": "Dallas 3", "nl": "Dallas 3" } }
      ]
    },
    {
      "type": "number",
      "name": "temperature",
      "title": {
        "en": "Temperature",
        "nl": "Temperatuur"
      },
      "min": -40,
      "max": 100,
      "step": 0.5
