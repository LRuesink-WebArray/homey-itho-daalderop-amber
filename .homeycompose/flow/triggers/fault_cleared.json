{
  "id": "fault_cleared",
  "title": {
    "en": "A fault has been cleared",
    "nl": "Een storing is opgelost"
  },
  "titleFormatted": {
    "en": "Fault [[fault_code]] has been cleared",
    "nl": "Storing [[fault_code]] is opgelost"
  },
  "hint": {
    "en": "Triggers when a specific fault code is cleared on the heat pump.",
    "nl": "Wordt geactiveerd wanneer een specifieke foutcode wordt opgeheven op de warmtepomp."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=heatpump"
    },
    {
      "type": "autocomplete",
      "name": "fault_code",
      "title": {
        "en": "Fault code",
        "nl": "Foutcode"
      },
      "placeholder": {
        "en": "Select a fault code...",
        "nl": "Selecteer een foutcode..."
      }
    }
  ],
  "tokens": [
    {
      "name": "fault_code",
      "type": "string",
      "title": {
        "en": "Fault code",
        "nl": "Foutcode"
      },
      "example": "P01"
    },
    {
      "name": "fault_description",
      "type": "string",
      "title": {
        "en": "Description",
        "nl": "Beschrijving"
      },
      "example": "Main line current protection"
    }
  ]
}
